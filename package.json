{
  "name": "bit-data-communication-demos",
  "version": "1.1.0",
  "private": true,
  "description": "Interactive teaching demos for data communication: bit stuffing/destuffing and the stop-and-wait protocol.",
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild src/bit_stuff.jsx src/stop_and_wait.jsx --bundle --format=iife --target=es2018 --outdir=js --log-level=warning",
    "build:css": "tailwindcss -i src/styles.css -o css/site.css --content \"./*.html,./src/**/*.jsx\" --minify",
    "test": "node --test \"test/*.test.mjs\"",
    "serve": "node scripts/serve.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "esbuild": "0.28.2",
    "tailwindcss": "3.4.19"
  }
}
